{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Value stored in User Secrets
    "DefaultConnection": "USE_USER_SECRETS"
  },
  "Jwt": {
    // Value stored in User Secrets
    "Secret": "USE_USER_SECRETS",
    "Issuer": "WebsiteDocumentsAPI",
    "Audience": "WebsiteDocumentsClient",
    "ExpiryDays": 7
  },
  "Google": {
    // Values stored in User Secrets
    "ClientId": "USE_USER_SECRETS",
    "ClientSecret": "USE_USER_SECRETS"
  },
  "Gemini": {
    // Value stored in User Secrets
    "ApiKey": "USE_USER_SECRETS"
  },
  "Email": {
    "Enabled": "true",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    // Values stored in User Secrets
    "Username": "USE_USER_SECRETS",
    "Password": "USE_USER_SECRETS",
    "FromEmail": "USE_USER_SECRETS"
  },
  "Storage": {
    "Provider": "neon",
    "Local": {
      "BasePath": "wwwroot/uploads",
      "BaseUrl": "/uploads"
    },
    "NeonStorage": {
      // Values stored in User Secrets
      "Endpoint": "USE_USER_SECRETS",
      "AccessKey": "USE_USER_SECRETS",
      "SecretKey": "USE_USER_SECRETS",
      "BucketName": "documents",
      "BaseUrl": "https://br-green-truth-aycm5oqx.storage.c-5.us-east-2.aws.neon.tech"
    }
  },
  "AllowedHosts": "*"
}
