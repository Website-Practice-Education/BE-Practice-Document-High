{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_HOST;Port=5432;Database=YOUR_DB_NAME;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;sslmode=require"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS",
    "Issuer": "WebsiteDocumentsAPI",
    "Audience": "WebsiteDocumentsClient",
    "ExpiryDays": 7
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY"
  },
  "Email": {
    "Enabled": "true",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "Username": "YOUR_EMAIL@gmail.com",
    "Password": "YOUR_EMAIL_APP_PASSWORD",
    "FromEmail": "YOUR_EMAIL@gmail.com"
  },
  "Storage": {
    "Provider": "local",
    "Local": {
      "BasePath": "wwwroot/uploads",
      "BaseUrl": "/uploads"
    }
  },
  "AllowedHosts": "*"
}
